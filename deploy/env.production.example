# Скопируйте в .env рядом с docker-compose.yml и заполните. Права: chmod 600 .env
DOMAIN=t-rodionova.ru
APP_URL=https://t-rodionova.ru
NEXT_PUBLIC_SITE_URL=https://t-rodionova.ru
NODE_ENV=production

# База данных. Вариант A (старт): PostgreSQL на этом же сервере — оставьте COMPOSE_PROFILES=localdb,
# DB_PASSWORD генерируется install.sh, DATABASE_URL уже указывает на контейнер db.
COMPOSE_PROFILES=localdb
DB_PASSWORD=
DATABASE_URL=postgresql://tr:${DB_PASSWORD}@db:5432/tr_rodionova
# Вариант B (рост): управляемый PostgreSQL хостера — уберите COMPOSE_PROFILES и впишите
# DATABASE_URL=postgresql://user:password@host:5432/tr_rodionova?sslmode=require

# Секреты: сгенерируйте `openssl rand -hex 32` для каждого
AUTH_SECRET=
CRON_SECRET=

# Первый администратор (создаётся при старте, если администраторов нет)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Демо-данные с известными паролями — только для стенда. В проде всегда 0
SEED_ON_START=0
ALLOW_DEMO_PAYMENTS=0

# Бэкапы базы в S3 (deploy/backup.sh)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=tr-rodionova-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
