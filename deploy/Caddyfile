# TLS от Let's Encrypt выпускается и продлевается автоматически. DOMAIN берётся из .env.
{$DOMAIN} {
	encode zstd gzip
	# web — имя сервиса в docker compose; при обновлении за ним несколько контейнеров,
	# неудачное соединение с исчезнувшим контейнером повторяется до 15 секунд
	reverse_proxy web:3000 {
		lb_try_duration 15s
		lb_try_interval 500ms
		transport http {
			dial_timeout 5s
		}
	}
	header {
		# остальные заголовки безопасности выставляет приложение
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

# www → без www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
