# TLS от Let's Encrypt выпускается и продлевается автоматически. DOMAIN берётся из .env.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		# остальные заголовки безопасности выставляет приложение
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

# www → без www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
