# Copy to .env for local development. Never commit the real .env file.
DATABASE_URL="postgresql://tr:change_me@localhost:5432/tr_rodionova?schema=public"
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
CRON_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"
APP_URL="http://localhost:3000"
SEED_ON_START=0
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS"
HEALTHCHECK_TOKEN="REPLACE_WITH_ANOTHER_RANDOM_SECRET"

# Encryption-key migration: leave unset until following docs/DEPLOY.md.
# Generate with: openssl rand -base64 48
# ENCRYPTION_KEY=
# Do not set ENCRYPTION_KEY_ACTIVE=1 until every serving instance supports enc:v2.
